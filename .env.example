# Copy to .env (git-ignored) and replace every change-me value.
# Comments must be on their own lines: the apps read this file as .properties,
# where a trailing "# ..." would become part of the value.

# --- Infrastructure (docker-compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shortener
# Host port. 5432 is often taken by a local Postgres.
POSTGRES_PORT=5434
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me

# --- shortener-service (port 8085) ---
POSTGRES_URL=jdbc:postgresql://localhost:5434/shortener
REDIS_URL=redis://localhost:6379
SHORTENER_BASE_URL=http://localhost:8085
# Feistel key (32+ bytes). Rotating it changes the code space for new links.
SHORTENER_CODE_SECRET=change-me-32-bytes-min
# name:sha256(key), comma-separated
SHORTENER_API_KEYS=dev:sha256-of-your-key
VISITOR_HASH_SALT_SECRET=change-me

# --- orchestrator-app (port 8086) ---
ORCH_POSTGRES_URL=jdbc:postgresql://localhost:5434/orchestrator
# live | record | replay
ORCH_LLM_MODE=replay
# Only needed for live/record mode.
ANTHROPIC_API_KEY=
ORCH_LLM_MODEL=claude-sonnet-5-5
ORCH_APPROVER_KEYS=alice:sha256-of-approver-key
ORCH_WORKSPACE_ROOT=../.agent-worktrees
