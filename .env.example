# Copy to .env (git-ignored) and replace every change-me value.

# --- Infrastructure (docker-compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shortener
POSTGRES_PORT=5434                                    # host port; 5432 is often taken by a local Postgres
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me

# --- shortener-service (port 8085) ---
POSTGRES_URL=jdbc:postgresql://localhost:5434/shortener
REDIS_URL=redis://localhost:6379
SHORTENER_BASE_URL=http://localhost:8085
SHORTENER_CODE_SECRET=change-me-32-bytes-min          # Feistel key; rotating it = new code space
SHORTENER_API_KEYS=dev:sha256-of-your-key             # name:sha256(key), comma-separated
VISITOR_HASH_SALT_SECRET=change-me

# --- orchestrator-app (port 8086) ---
ORCH_POSTGRES_URL=jdbc:postgresql://localhost:5434/orchestrator
ORCH_LLM_MODE=replay                                  # live | record | replay
ANTHROPIC_API_KEY=                                    # only for live/record
ORCH_LLM_MODEL=claude-sonnet-5-5
ORCH_APPROVER_KEYS=alice:sha256-of-approver-key
ORCH_WORKSPACE_ROOT=../.agent-worktrees
