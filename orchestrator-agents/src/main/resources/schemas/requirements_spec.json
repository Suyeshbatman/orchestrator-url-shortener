{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "requirements_spec",
  "description": "A normalized, testable statement of what to build. Every requirement has a stable id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["problemStatement", "functional", "nonFunctional", "acceptanceCriteria", "assumptions",
               "ambiguities", "outOfScope", "classification"],
  "properties": {
    "problemStatement": { "type": "string", "minLength": 1 },
    "functional": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "text", "priority"],
        "properties": {
          "id": { "type": "string", "pattern": "^FR-[0-9]+$" },
          "text": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["MUST", "SHOULD", "COULD"] }
        }
      }
    },
    "nonFunctional": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "text", "category"],
        "properties": {
          "id": { "type": "string", "pattern": "^NFR-[0-9]+$" },
          "text": { "type": "string", "minLength": 1 },
          "category": { "enum": ["PERFORMANCE", "SECURITY", "RELIABILITY", "PRIVACY", "OPERABILITY", "COMPATIBILITY", "OTHER"] }
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "requirementId", "given", "when", "then"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
          "requirementId": { "type": "string", "pattern": "^N?FR-[0-9]+$" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" }
        }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "question", "options", "severity", "proposedDefault"],
        "properties": {
          "id": { "type": "string", "pattern": "^AMB-[0-9]+$" },
          "question": { "type": "string", "minLength": 1 },
          "options": { "type": "array", "items": { "type": "string" } },
          "severity": { "enum": ["BLOCKING", "NONBLOCKING"] },
          "proposedDefault": { "type": "string" }
        }
      }
    },
    "outOfScope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "classification": { "enum": ["GREENFIELD", "BROWNFIELD"] }
  }
}
