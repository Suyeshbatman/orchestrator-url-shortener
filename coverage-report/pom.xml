<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.acme</groupId>
    <artifactId>orchestrator-url-shortener</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>coverage-report</artifactId>
  <packaging>pom</packaging>
  <name>coverage-report</name>
  <description>
    One JaCoCo report over every module (unit and integration tests), at
    coverage-report/target/site/jacoco-aggregate/index.html after verify. No code of its own.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.acme</groupId>
      <artifactId>shortener-service</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.acme</groupId>
      <artifactId>orchestrator-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme</groupId>
      <artifactId>orchestrator-agents</artifactId>
    </dependency>
    <dependency>
      <groupId>com.acme</groupId>
      <artifactId>orchestrator-app</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.acme</groupId>
      <artifactId>orchestrator-cli</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>aggregate</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
